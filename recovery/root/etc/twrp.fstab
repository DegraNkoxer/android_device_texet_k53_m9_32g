# twrp.fstab - Texet TM-5702 (k53_m9_32g / MT6753)
# Generado desde recovery.fstab y tabla de particiones del dispositivo
#
# Columnas: mountpoint  fstype  blockdevice  [blockdevice2]  flags

# ─── Particiones principales ──────────────────────────────────
/boot		emmc	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/boot		flags=display="Boot";backup=1;flashimg=1
/recovery	emmc	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/recovery		flags=display="Recovery";backup=1;flashimg=1
/system		ext4	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/system		flags=display="System";backup=1;wipeingui
/vendor		ext4	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/vendor		flags=display="Vendor";backup=1;wipeingui
/data		ext4	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/userdata		flags=display="Data";userdata;wipeingui
/cache		ext4	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/cache		flags=display="Cache";backup=1;wipeingui

# ─── Particiones de backup MTK ────────────────────────────────
/nvram		emmc	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvram		flags=display="NVRAM";backup=1
/nvdata		ext4	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvdata		flags=display="NVData";backup=1
/protect_f	ext4	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect1		flags=display="Protect F";backup=1
/protect_s	ext4	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect2		flags=display="Protect S";backup=1
/proinfo	emmc	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/proinfo		flags=display="Proinfo";backup=1
/misc		emmc	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/para		flags=display="Misc"

# ─── Bootloader / TEE (importante para backup) ────────────────
/lk		emmc	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/lk		flags=display="Bootloader (LK)";backup=1
/lk2		emmc	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/lk2		flags=display="Bootloader (LK2)";backup=1
/tee1		emmc	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/tee1		flags=display="TEE1";backup=1
/tee2		emmc	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/tee2		flags=display="TEE2";backup=1

# ─── Varios ───────────────────────────────────────────────────
/logo		emmc	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/logo		flags=display="Boot Logo";backup=1
/expdb		emmc	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/expdb		flags=display="ExpDB"
/secro		emmc	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/secro		flags=display="SecRO";backup=1
/frp		emmc	/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/frp		flags=display="FRP"

# ─── Almacenamiento externo ───────────────────────────────────
/external_sd	auto	/dev/block/mmcblk1p1	/dev/block/mmcblk1	flags=display="MicroSD";storage;wipeingui;removable
/usb_otg	auto	/dev/block/sda1		/dev/block/sda		flags=display="USB OTG";storage;wipeingui;removable
